---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; sizes: string; class?: string; caption?: string }
const { src, alt, sizes, caption, class: cls } = Astro.props;
// A large version for the lightbox.
const full = await getImage({ src, width: Math.min(src.width, 2000) });
---
<Image src={src} alt={alt} class={cls} widths={[400, 800, 1200, Math.min(src.width, 1600)].filter((w) => w <= src.width)} sizes={sizes} data-full={full.src} data-caption={caption} />

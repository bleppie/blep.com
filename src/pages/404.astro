---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Not found">
  <hr class="divider" />
  <p style="margin:40px 0">Sorry, that page isn't here. <a href={withBase('/works/')}>See all artwork</a>.</p>
</Base>
<script is:inline define:vars={{ base }}>
  // Old links like /index.php/works/... → /works/...
  const p = location.pathname.slice(base.length);
  if (p.startsWith('/index.php/')) location.replace(base + p.slice(10) + location.search);
</script>
